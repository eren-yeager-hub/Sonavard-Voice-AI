# ============================================================
# Aegis Voice AI — Environment Configuration Template
# Copy this file to `.env` and fill in your credentials.
# NEVER commit `.env` to Git!
# ============================================================

# Server binding (keep 127.0.0.1 for local-only security)
AEGIS_HOST=127.0.0.1
AEGIS_PORT=5000
AEGIS_DEBUG=false

# Set a persistent random 64-char hex string in production
AEGIS_SECRET_KEY=

# Safety: keep true while testing to prevent accidental SMS/Email alerts
AEGIS_ALERT_DRY_RUN=true
AEGIS_ALERT_COOLDOWN=25
AEGIS_CANCEL_WINDOW=5

# Privacy: only save short emergency clip when explicitly enabled
AEGIS_SAVE_EVIDENCE=false
AEGIS_MAX_EVIDENCE_CLIPS=20

# Email Alerts (Gmail App Password recommended — never use main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=
EMAIL_RECEIVER=
EMAIL_PASSWORD=

# Twilio SMS Alerts
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=
TARGET_PHONE=
