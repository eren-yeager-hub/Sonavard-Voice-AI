# ============================================================
# Sonavard Voice AI — Environment Configuration Template
# Copy this file to `.env` and fill in your credentials.
# NEVER commit `.env` to Git!
# ============================================================

# Server binding (keep 127.0.0.1 for local-only security)
SONAVARD_HOST=127.0.0.1
SONAVARD_PORT=5000
SONAVARD_DEBUG=false

# Set a persistent random 64-char hex string in production
SONAVARD_SECRET_KEY=

# Safety: keep true while testing to prevent accidental SMS/Email alerts
SONAVARD_ALERT_DRY_RUN=true
SONAVARD_ALERT_COOLDOWN=25
SONAVARD_CANCEL_WINDOW=5

# Privacy: only save short emergency clip when explicitly enabled
SONAVARD_SAVE_EVIDENCE=false
SONAVARD_MAX_EVIDENCE_CLIPS=20

# Email Alerts (Gmail App Password recommended — never use main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=
EMAIL_RECEIVER=
EMAIL_PASSWORD=

# Twilio SMS Alerts
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=
TARGET_PHONE=
